# Public package allowlist; local proof runs and agent notes stay outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/crucible.toml
!/crucible.lock
!/rtl/
!/formal/
!/tests/
!/docs/
!/evidence/
!/scripts/
/scripts/*
!/scripts/run.sh
!/scripts/counterexample.py
!/scripts/verify.py
!/scripts/preflight_git.py
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.token
**/.unlazy/
**/.codex/
**/.claude/
**/AGENTS.md
**/SKILL.md
**/GATES.md
**/WORKLOG.md
